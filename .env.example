# ─── BTG Lead Radar — Variables de Entorno ────────────────────────────────────
# Copia este archivo a .env y completa los valores antes de iniciar la app.
#
#   cp .env.example .env
#
# ──────────────────────────────────────────────────────────────────────────────

# ANTHROPIC_API_KEY — Requerida para el análisis de mercado con IA
#
# Obtén tu clave en: https://console.anthropic.com/keys
# El modelo usado es Claude Opus 4.6.
# Costo aproximado por análisis: $0.10 – $0.50 USD según la longitud.
#
ANTHROPIC_API_KEY=sk-ant-api03-...tu-clave-aqui...

# DATABASE_URL — URL de la base de datos SQLite (local por defecto)
#
# Para desarrollo local deja este valor tal cual.
# El archivo dev.db se crea automáticamente al correr: npm run setup
#
DATABASE_URL="file:./dev.db"
